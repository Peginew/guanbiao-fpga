# 2026-10-08 corrected by tracing wire rows, not adjacent pin-text baselines.
# K3/KEY2/B9 reset (R74, 3.3V); K4/KEY3/C7 mode (R73, 3.3V).
# K1/KEY0/D5 and K2/KEY1/A9 are unused (1.5V pull-ups). C8 is GPIOA30, not a button.

set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_rst_n }				{ LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }


#set_pin_assignment	{ O_screen_pwm } 		{ LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }


set_pin_assignment { I_mode_key_n } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# Reviewed board sheets _2/_7; DS1300 v1.2 PDF160: B17=HR BANK32 IO_R17P_32,T1.
# Shared R189/R193 divider and U46.EN node. Passive input; not a power output.
# BANK32=3.3V; no pull-up/down added to the 20k/20k divider.
set_pin_assignment { I_hdmi_hpd_en_sense } { LOCATION = B17; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# P04_DIG_LED schematic physical D0..7/S0..7. SW6 must select DIGVCC.
set_pin_assignment { O_meter_segment_n[0] } { LOCATION = C9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[1] } { LOCATION = C11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[2] } { LOCATION = B11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[3] } { LOCATION = E7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[4] } { LOCATION = E6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[5] } { LOCATION = B6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[6] } { LOCATION = B7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_segment_n[7] } { LOCATION = E5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[0] } { LOCATION = G15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[1] } { LOCATION = G14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[2] } { LOCATION = A17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[3] } { LOCATION = A18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[4] } { LOCATION = B16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[5] } { LOCATION = A15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[6] } { LOCATION = B15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_meter_digit_n[7] } { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# User-requested saturation switches; D087 PDF3/9, SW1->SW0/A4 and SW2->SW1/B4.
set_pin_assignment { I_saturation_sw[0] } { LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_saturation_sw[1] } { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# SW3/SW4 display-only preset inputs, exact prior reviewed REF pin assignments.
set_pin_assignment { I_preset_sw[0] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_preset_sw[1] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
